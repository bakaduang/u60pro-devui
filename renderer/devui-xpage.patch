+/* Tile glyph + tint: <meta name="devui-icon"/"devui-tint"> override the
+ * built-in table; otherwise the first character of the title is used. */
+static void function_tile_style(const char *name, const char *html, const char *title,
+                                char *icon, size_t icap, char *tint, size_t tcap)
+{
+    static const struct { const char *page, *icon, *tint; } known[] = {
+        { "tailscale.html", "T", "blue" },      { "clash.html", "C", "purple" },
+        { "mihomo.html", "M", "purple" },       { "cpu-performance.html", "芯", "amber" },
+        { "wireguard.html", "W", "green" },     { "operator-lock.html", "营", "orange" },
+        { "fmswitch.html", "猫", "pink" },      { "sim-switch.html", "卡", "orange" },
+        { "sim-traffic.html", "量", "teal" },   { "timezone.html", "时", "slate" },
+    };
+    static const char *tints[] = { "blue", "green", "purple", "orange", "teal", "pink", "amber", "slate" };
+    char m[48];
+    icon[0] = 0; tint[0] = 0;
+    for (size_t i = 0; i < ARRAY_LEN(known); i++)
+        if (!strcmp(name, known[i].page)) {
+            snprintf(icon, icap, "%s", known[i].icon);
+            snprintf(tint, tcap, "%s", known[i].tint);
+        }
+    if (function_meta_from_html(html, "devui-icon", m, sizeof m)) snprintf(icon, icap, "%s", m);
+    if (function_meta_from_html(html, "devui-tint", m, sizeof m)) {
+        int ok = 1;
+        for (const char *q = m; *q; q++) if (!(*q >= 'a' && *q <= 'z')) ok = 0;
+        if (ok) snprintf(tint, tcap, "%s", m);
+    }
+    if (!icon[0] && title && title[0]) {
+        size_t l = 1;
+        unsigned char c = (unsigned char)title[0];
+        if (c >= 0xF0) l = 4; else if (c >= 0xE0) l = 3; else if (c >= 0xC0) l = 2;
+        if (l >= icap) l = icap - 1;
+        memcpy(icon, title, l);
+        icon[l] = 0;
+        if (l == 1 && icon[0] >= 'a' && icon[0] <= 'z') icon[0] = (char)(icon[0] - 32);
+    }
+    if (!tint[0]) {
+        unsigned h = 5381;
+        for (const char *q = name; *q; q++) h = h * 33u + (unsigned char)*q;
+        snprintf(tint, tcap, "%s", tints[h % ARRAY_LEN(tints)]);
+    }
+}
