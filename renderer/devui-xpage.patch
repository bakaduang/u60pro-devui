+/*
+ * xpage.h - adapter-backed custom function pages for u60pro-devui.
+ *
+ * A page ui/functions/<name>.html may ship a sibling shell adapter
+ * ui/functions/<name>.sh. While that page is on screen the renderer runs
+ * `sh <name>.sh status` in the background and exposes every KEY=VALUE line it
+ * prints as the template token {{X_KEY}}. Anchors `act:x:<verb>` (and the
+ * two-tap confirm form `act:xc:<verb>`) run `sh <name>.sh <verb>` in the
+ * background, then refresh the status. No call ever blocks the UI thread.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef U60PRO_XPAGE_H
+#define U60PRO_XPAGE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define XPAGE_API_MARKER "DEVUI-XPAGE-API-2"
+#define XPAGE_RUN_DIR    "/tmp/devui-x"
+
+/* Call once at startup (creates the run dir, records the API marker). */
+void xpage_init(void);
+
+/* Bind the template-token store to the page being rendered. Pages without an
+ * adapter unbind it, so {{X_*}} tokens render empty everywhere else. */
+void xpage_prepare(const char *page_path);
+
+/* Periodic work for the visible page: reload fresh status output, collect
+ * finished-action messages, and schedule the next background status run.
+ * Returns 1 when the page should be re-rendered. `toast` receives a message
+ * (HTML-escaped) when an action finished. */
+int xpage_tick(const char *page_path, uint32_t now_ms, int screen_on,
+               char *toast, size_t toast_cap);
+
+/* Handle act:x:<verb> (confirm=0) or act:xc:<verb> (confirm=1).
+ * Always fills `toast` with user feedback. Returns 1 if a command started. */
+int xpage_action(const char *page_path, const char *verb, int confirm,
+                 uint32_t now_ms, const char *posix_tz,
+                 char *toast, size_t toast_cap);
+
+/* Renderer-local actions (API 2): act:xv:<view> and act:xp:<list>:<op>.
+ * Returns 1 when the page should be re-rendered, 2 when the view changed
+ * (scroll back to top). No shell is involved. */
+int xpage_local(const char *page_path, const char *act, uint32_t now_ms);
+
+/* Kick an immediate status refresh (page just opened). */
+void xpage_opened(const char *page_path, uint32_t now_ms);
+
+/* Template fallback for tokens starting with "X_" or "XS_"; never NULL. */
+const char *xpage_lookup(const char *key, size_t key_len);
+
+/* 1 if `page_path` is a function page that has a readable adapter. */
+int xpage_has_adapter(const char *page_path);
+
+#endif /* U60PRO_XPAGE_H */
