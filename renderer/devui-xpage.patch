+/* <meta name="NAME" content="VALUE"> from an HTML string (first match). */
+static int function_meta_from_html(const char *html, const char *name, char *dst, size_t cap)
+{
+    char needle[64];
+    const char *p, *tag_end, *c, *v;
+    char q;
+    size_t l;
+    if (!html || !name || !dst || cap == 0) return 0;
+    dst[0] = 0;
+    for (int quote = 0; quote < 2; quote++) {
+        snprintf(needle, sizeof needle, quote ? "name='%s'" : "name=\"%s\"", name);
+        p = strcasestr(html, needle);
+        if (!p) continue;
+        tag_end = strchr(p, '>');
+        c = strcasestr(p, "content=");
+        if (!c || (tag_end && c > tag_end)) continue;
+        c += 8;
+        q = *c;
+        if (q != '"' && q != '\'') continue;
+        v = c + 1;
+        const char *e = strchr(v, q);
+        if (!e || (tag_end && e > tag_end)) continue;
+        l = (size_t)(e - v);
+        if (l >= cap) {
+            l = cap - 1;
+            while (l > 0 && ((unsigned char)v[l] & 0xC0) == 0x80) l--;
+        }
+        memcpy(dst, v, l);
+        dst[l] = 0;
+        return dst[0] != 0;
+    }
+    return 0;
+}
+
+static int function_meta_from_file(const char *path, const char *name, char *dst, size_t cap)
+{
+    char *html = read_file(path);
+    int ok;
+    if (!html) { if (dst && cap) dst[0] = 0; return 0; }
+    ok = function_meta_from_html(html, name, dst, cap);
+    free(html);
+    return ok;
+}
